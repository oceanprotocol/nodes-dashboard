# Copy to .env.local and fill in. See README "Environment Variables" for details.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- App (required) ---
# "production" uses Base mainnet and production backends; any other value uses Ethereum Sepolia and dev backends.
NEXT_PUBLIC_APP_ENV=

# --- Auth & wallets (required) ---
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_POLICY_ID=
# Google login redirect URL, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- RPC (required in production only) ---
# Base mainnet Alchemy RPC URL. Server-side only; backs /api/rpc and server-side signers.
ALCHEMY_RPC_URL=

# --- Compute (required) ---
# Comma-separated GPU models shown in the job and inference wizards
NEXT_PUBLIC_GPU_LIST=

# --- Fiat on-ramp (required for card top-ups) ---
NEXT_PUBLIC_RAMP_API_KEY=

# --- Subsidy flow (required for subsidy pages) ---
GEMINI_API_KEY=
SUBSIDY_GSHEETS_SERVICE_ACCOUNT_EMAIL=
SUBSIDY_GSHEETS_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SUBSIDY_GSHEETS_SPREADSHEET_ID=
SUBSIDY_GSHEETS_SHEET_NAME=
SUBSIDY_GMAIL_ADDRESS=
SUBSIDY_GMAIL_OAUTH_CLIENT_ID=
SUBSIDY_GMAIL_OAUTH_CLIENT_SECRET=
SUBSIDY_GMAIL_OAUTH_REFRESH_TOKEN=
SUBSIDY_ACCESS_LIST_ADDRESS=
SUBSIDY_ACCESS_LIST_PRIVATE_KEY=
# Comma-separated provider addresses on the active chain
NEXT_PUBLIC_SUBSIDY_PROVIDERS=

# --- Optional ---
# Content-Security-Policy mode for src/proxy.ts: report-only (default), enforce, or off
# CSP_MODE=report-only
# NEXT_PUBLIC_LEGACY_ESCROW_ADDRESS=
# NEXT_PUBLIC_OUTAGE_BANNER_ENABLED=false
# NEXT_PUBLIC_OUTAGE_BANNER_MESSAGE=
# NEXT_PUBLIC_DEFAULT_MODEL_PEER_IDS=
# NEXT_PUBLIC_VLLM_TAG=v0.28.0
# NEXT_PUBLIC_LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp
# NEXT_PUBLIC_LLAMACPP_TAG=server
# NEXT_PUBLIC_LLAMACPP_TAG_CUDA=server-cuda
# NEXT_PUBLIC_RAMP_GET_STATUS_INTERVAL=5000
# NEXT_PUBLIC_RAMP_GET_STATUS_MAX_TRIES=20
